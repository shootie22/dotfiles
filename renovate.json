{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only the workflows' actions: flake.lock is the weekly update's (modules/nixos/weekly-update). Run from the infrastructure repo's Renovate workflow.",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "dependencyDashboard": false,
  "timezone": "Europe/Bucharest",
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "description": "All action updates in one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "workflow actions",
      "groupSlug": "workflow-actions"
    }
  ]
}
