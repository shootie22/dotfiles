{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/weather",
    "custom/notification",
    "custom/clipboard",
    "tray",
    "custom/screencast",
    "backlight",
    "pulseaudio",
    "cpu",
    "temperature",
    "memory",
    "battery"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by-number": true,
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 64,
    "separate-outputs": true
  },

  "clock": {
    "interval": 1,
    "locale": "da_DK.utf8",
    "format": "{:L%a %d %b  %H:%M:%S}",
    "tooltip-format": "<big>{:L%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months": "<span color='#f0f5f7'><b>{}</b></span>",
        "weekdays": "<span color='#7fc7b4'><b>{}</b></span>",
        "weeks": "<span color='#9fb0bc'>U{}</span>",
        "today": "<span color='#f2c66d'><b><u>{}</u></b></span>"
      }
    },
    "on-click": "kitty --title calcurse -e calcurse"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/weather": {
    "exec": "waybar-weather",
    "return-type": "json",
    "interval": 1800,
    "tooltip": true,
    "on-click": "kitty --title weather -e bash -lc 'waybar-weather --forecast; echo; read -r -p \"press enter to close\" _'"
  },

  "custom/notification": {
    "tooltip": true,
    "format": "{icon} {0}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -C -sw",
    "escape": true
  },

  "custom/clipboard": {
    "tooltip": true,
    "format": "",
    "tooltip-format": "Clipboard history",
    "on-click": "clipboard-history",
    "on-click-right": "clipboard-history --clear"
  },

  "custom/screencast": {
    "exec": "screencast-status",
    "exec-if": "screencast-status --active",
    "return-type": "json",
    "interval": 2
  },

  "backlight": {
    "device": "amdgpu_bl1",
    "format": "󰃠 {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "kitty --title wiremix -e wiremix",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%"
  },

  "temperature": {
    "interval": 5,
    "critical-threshold": 85,
    "format": " {temperatureC}°C"
  },

  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G"
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
