#!/usr/bin/env bash
set -eu

screenshot_dir=${SCREENGRAB_SCREENSHOT_DIR:-$HOME/Media/Screengrabs/Screenshots}
mkdir -p "$screenshot_dir"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    summary=$1
    body=$2
    icon=${3:-}

    if [ -n "$icon" ]; then
      notify-send -i "$icon" "$summary" "$body" >/dev/null 2>&1 || true
    else
      notify-send "$summary" "$body" >/dev/null 2>&1 || true
    fi
  fi
}

timestamp=$(date +%Y-%m-%d_%H-%M-%S)
file=$screenshot_dir/screenshot-$timestamp.png

if grimblast --freeze save area "$file"; then
  notify "Screenshot saved" "$file" "$file"
fi
