#!/usr/bin/env bash
set -eu

recording_dir=${SCREENGRAB_RECORDING_DIR:-$HOME/Media/Screengrabs/Recordings}
runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
pid_file=$runtime_dir/screengrab-recording.pid
path_file=$runtime_dir/screengrab-recording.path
log_file=/tmp/wf-recorder.log

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    summary=$1
    body=$2
    icon=${3:-}

    if [ -n "$icon" ]; then
      notify-send -i "$icon" "$summary" "$body" >/dev/null 2>&1 || true
    else
      notify-send "$summary" "$body" >/dev/null 2>&1 || true
    fi
  fi
}

thumbnail_for() {
  file=$1
  thumbnail_dir=${XDG_CACHE_HOME:-$HOME/.cache}/screengrab-thumbnails
  thumbnail=$thumbnail_dir/$(basename "${file%.*}").jpg

  if command -v ffmpegthumbnailer >/dev/null 2>&1 && [ -s "$file" ]; then
    mkdir -p "$thumbnail_dir"
    find "$thumbnail_dir" -type f -mtime +14 -delete 2>/dev/null || true
    ffmpegthumbnailer -i "$file" -o "$thumbnail" -s 512 >/dev/null 2>&1 || true
  fi

  if [ -f "$thumbnail" ]; then
    printf '%s\n' "$thumbnail"
  fi
}

is_recording() {
  [ -f "$pid_file" ] || return 1

  pid=$(cat "$pid_file")
  [ -n "$pid" ] || return 1

  command=$(ps -p "$pid" -o args= 2>/dev/null || true)
  case "$command" in
    *wf-recorder*) return 0 ;;
    *) return 1 ;;
  esac
}

if [ -f "$pid_file" ]; then
  if is_recording; then
    pid=$(cat "$pid_file")
    file=$(cat "$path_file" 2>/dev/null || true)

    kill -INT "$pid"

    for _ in 1 2 3 4 5; do
      if ! kill -0 "$pid" 2>/dev/null; then
        break
      fi
      sleep 0.2
    done

    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid"
    fi

    rm -f "$pid_file" "$path_file"
    thumbnail=$(thumbnail_for "$file" || true)
    notify "Recording saved" "$file" "$thumbnail"
    exit 0
  fi

  rm -f "$pid_file" "$path_file"
fi

geometry=$(slurp)
[ -n "$geometry" ] || exit 0

mkdir -p "$recording_dir"

timestamp=$(date +%Y-%m-%d_%H-%M-%S)
file=$recording_dir/recording-$timestamp.mp4

nohup wf-recorder -g "$geometry" -f "$file" >"$log_file" 2>&1 &
pid=$!

sleep 0.2
if ! kill -0 "$pid" 2>/dev/null; then
  rm -f "$pid_file" "$path_file"
  notify "Recording failed" "$log_file"
  exit 1
fi

printf '%s\n' "$pid" > "$pid_file"
printf '%s\n' "$file" > "$path_file"
notify "Recording started" "$file"
