#!/usr/bin/env bash
set -eu

# Paths are relative to this repo layout:
# home/bro/scripts/wallpaper/change-wallpaper
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
home_dir=$(cd -- "$script_dir/../.." && pwd -P)

# Override these if you copy the script to another setup.
wallpaper_dir=${CHWP_WALLPAPER_DIR:-$home_dir/wallpapers}
hyprpaper_config=${CHWP_HYPRPAPER_CONFIG:-$home_dir/hypr/hyprpaper.conf}

usage() {
  echo "usage: $(basename "$0") [-m|--move-file] IMAGE" >&2
}

move_file=false
case "${1:-}" in
  -m|--move-file)
    move_file=true
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

image=$1
case "$image" in
  "~/"*) image="$HOME/${image#"~/"}" ;;
esac

if [ ! -f "$image" ]; then
  echo "$(basename "$0"): file not found: $image" >&2
  exit 1
fi

image=$(realpath "$image")
filename=$(basename "$image" | tr ' ' '_' | tr -cd '[:alnum:]._-')

if [ -z "$filename" ]; then
  echo "$(basename "$0"): unsupported filename" >&2
  exit 1
fi

dest=$wallpaper_dir/$filename

if [ -e "$dest" ] && ! cmp -s "$image" "$dest"; then
  name=${filename%.*}
  ext=
  if [ "$name" != "$filename" ]; then
    ext=".${filename##*.}"
  fi

  hash=$(sha256sum "$image" | cut -c1-12)
  dest=$wallpaper_dir/$name-$hash$ext
fi

mkdir -p "$wallpaper_dir"

if [ "$image" != "$(realpath -m "$dest")" ]; then
  if [ "$move_file" = true ]; then
    mv -f "$image" "$dest"
  else
    cp -f "$image" "$dest"
  fi
fi

{
  printf 'preload = %s\n' "$dest"
  printf 'wallpaper = ,%s\n\n' "$dest"
  printf 'ipc = true\n'
  printf 'splash = false\n'
} > "$hyprpaper_config"

if ! hyprctl hyprpaper reload ",$dest"; then
  hyprpaper -c "$HOME/.config/hypr/hyprpaper.conf" >/tmp/hyprpaper.log 2>&1 &
  sleep 0.5
  hyprctl hyprpaper reload ",$dest"
fi

echo "$dest"
